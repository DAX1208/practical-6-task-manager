# ==============================================================================
# ROOT DOCKER-COMPOSE ENVIRONMENT CONFIGURATION
# Copy to .env for local Docker Compose overrides
# ==============================================================================

# Backend Port & MongoDB Connection
PORT=5000
MONGO_URI=mongodb://mongodb:27017/taskdb

# JWT Authentication Secret
JWT_SECRET=awdf_task_manager_secret_key_2026

# Frontend API URL
VITE_API_URL=http://localhost:5000

# Optional Redis Cache URL (falls back to In-Memory cache if disabled)
REDIS_URL=redis://127.0.0.1:6379

# OpenAI API Key for Practical 13 AI Description Generation
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional Google Gemini AI API Key for Intelligent Task Breakdown
# Get your free key at: https://aistudio.google.com/
# If left empty, system automatically uses intelligent heuristic breakdown
GEMINI_API_KEY=
